rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: default deny all undefined collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for validating security state
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Schema and structure validation helper for a User profile document
    function isValidUser(data) {
      return data.userName is string 
        && data.userName.size() >= 1 
        && data.userName.size() <= 100
        && data.streak is int
        && data.streak >= 0
        && data.lastActive is string
        && data.completedAssessments is list
        && data.bookmarks is list
        && data.achievements is list;
    }

    // Match block for the User profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data)
        && (
          // Action: Save general progress update (Streak, Name, History, Bookmarks, Achievements)
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['userName', 'streak', 'lastActive', 'completedAssessments', 'bookmarks', 'achievements', 'updatedAt'])
        );
      allow delete: if isOwner(userId);
    }
  }
}
